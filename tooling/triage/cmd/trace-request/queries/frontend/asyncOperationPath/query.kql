database('{{ .ServiceDatabase }}').table('frontendLogs')
| where timestamp between ({{ kqlDatetime .StartTime }} .. {{ kqlDatetime .EndTime }})
| where log.correlation_id == '{{ .CorrelationID }}'
| where log.msg == 'response complete'
| where log.method == 'put' or log.method == 'post'
| project tolower(tostring(parse_url(tostring(log["Header---Azure-AsyncOperation"])).Path))
| limit 1
